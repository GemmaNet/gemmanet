# Copy to .env and fill in. See deploy/DEPLOY.md.

# Default layout: the website + docs are on Cloudflare Pages (gemmanet.net)
# and this server runs the coordinator on api.gemmanet.net. See deploy/DEPLOY.md.

# Public URL of the coordinator; the dashboard calls the API here.
PUBLIC_URL=https://api.gemmanet.net
# The main website, for "home" and docs links from the dashboard and forum.
SITE_URL=https://gemmanet.net

# Hostnames Caddy serves (comma-separated). API_HOST sends everything to the
# coordinator (it must also be listed in SITE_ADDRESSES).
SITE_ADDRESSES=api.gemmanet.net
API_HOST=api.gemmanet.net
# To serve everything from this server instead (no Pages):
#   PUBLIC_URL=https://gemmanet.net  SITE_URL=/
#   SITE_ADDRESSES=gemmanet.net, www.gemmanet.net, api.gemmanet.net

# origin: Cloudflare Origin Certificate in deploy/certs/origin.pem + origin.key
# none:   plain HTTP (local testing, with http:// site addresses)
TLS_MODE=origin

# Host ports Caddy listens on (staging uses 8080/8443).
HTTP_PORT=80
HTTPS_PORT=443

# Secrets: generate with  openssl rand -hex 24
POSTGRES_PASSWORD=
ADMIN_KEY=

# API key for the seed nodes (docker compose --profile seeds up -d).
# Get one after the first start: curl -X POST https://gemmanet.net/api/v1/register
GEMMANET_API_KEY=

LOG_LEVEL=INFO
